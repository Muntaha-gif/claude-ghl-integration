# GoHighLevel Private Integration Token.
# Create one in GHL: sub-account > Settings > Private Integrations > Create.
# Grant it the scopes you want the MCP server to use, e.g.:
#   contacts, conversations, conversations/message, opportunities,
#   locations, locations/tags, locations/customFields, calendars,
#   calendars/events
GHL_PIT=pit-00000000-0000-0000-0000-000000000000

# The sub-account (location) ID this server operates on.
# Find it in GHL: sub-account > Settings > Business Profile,
# or in the URL: app.gohighlevel.com/v2/location/<LOCATION_ID>/...
GHL_LOCATION_ID=your_location_id_here
